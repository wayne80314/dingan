{
  "name": "dingan-app",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev:hook": "wrangler dev -c wrangler.hook.jsonc",
    "dev:app": "wrangler dev -c wrangler.app.jsonc",
    "deploy:hook": "wrangler deploy -c wrangler.hook.jsonc",
    "deploy:app": "wrangler deploy -c wrangler.app.jsonc",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "db:migrate:local": "wrangler d1 migrations apply dingan --local -c wrangler.hook.jsonc",
    "db:migrate:remote": "wrangler d1 migrations apply dingan --remote -c wrangler.hook.jsonc",
    "smoke": "node scripts/smoke/run.mjs"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.1.0",
    "@cloudflare/workers-types": "^5.20260826.1",
    "hono": "^4.13.5",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11",
    "wrangler": "^4.126.0"
  }
}
