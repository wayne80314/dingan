{
  "name": "dingan-app",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev:hook": "wrangler dev -c wrangler.hook.jsonc",
    "dev:app": "wrangler dev -c wrangler.app.jsonc",
    "deploy:hook": "wrangler deploy -c wrangler.hook.jsonc",
    "deploy:app": "npm run build:web && wrangler deploy -c wrangler.app.jsonc",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit && tsc --noEmit -p web/tsconfig.json",
    "db:migrate:local": "wrangler d1 migrations apply dingan --local -c wrangler.hook.jsonc",
    "db:migrate:remote": "wrangler d1 migrations apply dingan --remote -c wrangler.hook.jsonc",
    "smoke": "node scripts/smoke/run.mjs",
    "build:web": "vite build --config web/vite.config.ts web",
    "dev:web": "vite --config web/vite.config.ts web"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.1.0",
    "@cloudflare/workers-types": "^5.20260826.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.0",
    "hono": "^4.13.5",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "typescript": "^5.9.3",
    "vite": "^8.2.2",
    "vitest": "^4.1.11",
    "wrangler": "^4.126.0"
  }
}