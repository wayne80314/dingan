{
  // Dashboard worker. Access control is Cloudflare Access in front of this
  // hostname for M0.1 -- see docs/m0-plan.md.
  "name": "dingan-app",
  "main": "src/app/index.ts",
  "compatibility_date": "2026-08-25",
  "compatibility_flags": ["nodejs_compat"],

  "d1_databases": [
    { "binding": "DB", "database_name": "dingan", "database_id": "325c87af-f6c7-413a-b0fa-ae1161152d35" }
  ],

  "r2_buckets": [
    { "binding": "MEDIA", "bucket_name": "dingan-media" },
    { "binding": "RAW", "bucket_name": "dingan-raw" }
  ],

  "vars": {
    "LINE_PROVIDER_ID": "2011286772",
    "LINE_CHANNEL_ID": "2011286772"
  },

  // The dashboard bundle ships with this worker, so one deploy serves both the
  // page and its API and there is no cross-origin setup to get wrong.
  // single-page-application handling lets client-side view state survive a
  // refresh instead of 404ing.
  "assets": {
    "directory": "./web/dist",
    "not_found_handling": "single-page-application"
  },

  // Retries sends that failed or timed out. Frequent enough that a stuck
  // decision card is not stuck for long.
  "triggers": { "crons": ["*/5 * * * *"] }
}
